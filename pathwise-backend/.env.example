# Database Connection Template (Replace with your PostgreSQL credentials)
DB_URL=jdbc:postgresql://<DB_HOST>:5432/<DB_NAME>?sslmode=require
DB_USERNAME=<YOUR_DB_USERNAME>
DB_PASSWORD=<YOUR_DB_PASSWORD>

# Application Server Port
PORT=8080

# Supabase Storage Configuration (Optional - for cloud handbook storage)
SUPABASE_URL=https://<PROJECT-REF>.supabase.co
SUPABASE_KEY=<YOUR_SUPABASE_API_KEY>
SUPABASE_BUCKET=PathWise

# Administrator Configuration (Environment variable driven)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password_here

# Gmail SMTP Mail Service Template (For sending 6-digit OTP emails)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
